# ─────────────────────────────────────────────────────────────
# Cerberus — пример конфигурации (.env.example)
# Скопируйте в .env и заполните нужные значения.
# ─────────────────────────────────────────────────────────────

# ── Торговые параметры ────────────────────────────────────────
# Размер ставки на каждую пару YES+NO (в USDC)
TRADE_NOTIONAL_USDC=25

# Минимальный чистый edge для входа в позицию (1.25% по умолчанию)
# Уменьшите до 0.01 чтобы поймать больше сигналов, увеличьте до 0.02
# для более консервативного фильтра
MIN_NET_EDGE_PCT=0.0125

# ── Подключение к Polymarket ──────────────────────────────────
GAMMA_HOST=gamma-api.polymarket.com
CLOB_REST_URL=https://clob.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── База данных ───────────────────────────────────────────────
DB_PATH=cerberus.db

# ── Безопасность ─────────────────────────────────────────────
# НИКОГДА не ставьте true — реальные сделки не поддерживаются
ALLOW_LIVE_MODE=false

# ── Telegram уведомления ──────────────────────────────────────
# Получить токен: @BotFather → /newbot
# Получить chat_id: написать боту /start, затем открыть
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
#   и найти "chat": {"id": 123456789}
#
# Оставьте пустыми если уведомления не нужны:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
