# ─────────────────────────────────────────────────────────────
# Cerberus — пример конфигурации (.env.example)
# Скопируйте в .env и заполните нужные значения.
# ─────────────────────────────────────────────────────────────

# ── Торговые параметры ────────────────────────────────────────
# Размер ставки на каждую пару YES+NO (в USDC)
TRADE_NOTIONAL_USDC=50

# Минимальный чистый edge для входа в позицию.
# Поднято с дефолтных 1.25%/2% — Polymarket ввёл taker fee 0.75-1.80% на p≈0.5,
# ровно там где живёт YES+NO арбитраж.
MIN_NET_EDGE_PCT=0.035
MIN_NET_EDGE_USD=0.40

SLIPPAGE_BUFFER_PCT=0.005
LEGGED_RISK_BUFFER_PCT=0.003

# Максимум попыток исполнения в скользящий час (RiskManager).
# Дефолт в коде — 60, что душит трафик уже при нескольких параллельных рынках
# (см. MAX_OPEN_MARKETS) — весь поток блокируется с reason=hourly_attempt_cap.
# На 5 параллельных рынков с ~60с циклом опроса нужно заметно больше 60/час.
MAX_ATTEMPTS_PER_HOUR=600

# Сколько рынков отслеживаем параллельно (Watcher + RiskManager).
# Дефолт в коде — 1. Без этой строки в .env — тихо откатится на 1 рынок.
MAX_OPEN_MARKETS=5

# ── Подключение к Polymarket ──────────────────────────────────
# ВАЖНО: схема обязательна (https://) — без неё market_discovery.py
# соберёт невалидный URL и все запросы дискавери будут падать.
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_REST_URL=https://clob.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── База данных ───────────────────────────────────────────────
DB_PATH=cerberus.db

# ── Стратегия исполнения ─────────────────────────────────────
# "FOK"    — fill-or-kill, taker, немедленно.
#            На ликвидных эффективных рынках best_yes_ask+best_no_ask обычно
#            $1.01-1.02 — FOK структурно убыточен (платит спред), не просто
#            "ниже порога". Не рассчитывайте на положительный edge_net_pct
#            здесь без реальной рыночной неэффективности.
# "MAKER"  — лимитные ордера на (best_ask - MAKER_OFFSET_TICKS), нулевая
#            комиссия + rebate, порог edge вдвое ниже FOK.
# "HYBRID" — сначала MAKER, при неудаче — fallback на FOK. Рекомендуемый
#            дефолт для paper-run на уже ликвидных рынках.
ORDER_STRATEGY=HYBRID

# Параметры maker-стратегии (активны только при ORDER_STRATEGY=MAKER/HYBRID)
MAKER_OFFSET_TICKS=1          # сколько тиков ниже best ask ставить ордер
MAKER_TIMEOUT_SECONDS=45      # отмена если не исполнен за N секунд
MAKER_MIN_FILL_PCT=0.70       # принять частичное исполнение если >= 70%
MAKER_REBATE_SHARE=0.25       # доля rebate от собранных taker fees (0.25 = 25%)

# ── Безопасность ─────────────────────────────────────────────
# Для paper trading — оставьте false
# Для live trading — поставьте true И заполните ключи ниже
DRY_RUN_MODE=true
ALLOW_LIVE_MODE=false

# ── Live trading: API ключи Polymarket ───────────────────────
# Как получить:
# 1. Зайди на polymarket.com → Profile → Settings → API Keys
# 2. Нажми "Create API Key" — сохрани key, secret, passphrase
# 3. POLYMARKET_PK — приватный ключ твоего Polygon кошелька
#    (hex строка, начинается с 0x)
#
# ⚠️ НИКОГДА не коммить .env в git — добавь его в .gitignore
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PK=
POLYMARKET_CHAIN_ID=137

# ── Telegram уведомления ──────────────────────────────────────
# Получить токен: @BotFather → /newbot
# Получить chat_id: написать боту /start, затем открыть
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
#   и найти "chat": {"id": 123456789}
#
# Оставьте пустыми если уведомления не нужны:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
