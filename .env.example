# ─────────────────────────────────────────────────────────────
# Cerberus — пример конфигурации (.env.example)
# Скопируйте в .env и заполните нужные значения.
# ─────────────────────────────────────────────────────────────

# ── Торговые параметры ────────────────────────────────────────
# Размер ставки на каждую пару YES+NO (в USDC)
TRADE_NOTIONAL_USDC=25

# Минимальный чистый edge для входа в позицию (1.25% по умолчанию)
# Уменьшите до 0.01 чтобы поймать больше сигналов, увеличьте до 0.02
# для более консервативного фильтра
MIN_NET_EDGE_PCT=0.0125

# ── Подключение к Polymarket ──────────────────────────────────
GAMMA_HOST=gamma-api.polymarket.com
CLOB_REST_URL=https://clob.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── База данных ───────────────────────────────────────────────
DB_PATH=cerberus.db

# ── Стратегия исполнения ─────────────────────────────────────
# "FOK"    — fill-or-kill, taker, немедленно (по умолчанию)
# "MAKER"  — лимитные ордера, нулевая комиссия + rebate
# "HYBRID" — сначала maker, при неудаче FOK
ORDER_STRATEGY=FOK

# Параметры maker-стратегии (активны только при ORDER_STRATEGY=MAKER/HYBRID)
MAKER_OFFSET_TICKS=1          # сколько тиков ниже best ask ставить ордер
MAKER_TIMEOUT_SECONDS=45      # отмена если не исполнен за N секунд
MAKER_MIN_FILL_PCT=0.70       # принять частичное исполнение если >= 70%
MAKER_REBATE_SHARE=0.25       # доля rebate от собранных taker fees (0.25 = 25%)

# ── Безопасность ─────────────────────────────────────────────
# Для paper trading — оставьте false
# Для live trading — поставьте true И заполните ключи ниже
ALLOW_LIVE_MODE=false

# ── Live trading: API ключи Polymarket ───────────────────────
# Как получить:
# 1. Зайди на polymarket.com → Profile → Settings → API Keys
# 2. Нажми "Create API Key" — сохрани key, secret, passphrase
# 3. POLYMARKET_PK — приватный ключ твоего Polygon кошелька
#    (hex строка, начинается с 0x)
#
# ⚠️ НИКОГДА не коммить .env в git — добавь его в .gitignore
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PK=
POLYMARKET_CHAIN_ID=137

# ── Telegram уведомления ──────────────────────────────────────
# Получить токен: @BotFather → /newbot
# Получить chat_id: написать боту /start, затем открыть
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
#   и найти "chat": {"id": 123456789}
#
# Оставьте пустыми если уведомления не нужны:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
